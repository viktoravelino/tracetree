{
  "name": "tracetree",
  "version": "0.1.2",
  "description": "Watch Claude Code agents and subagents work: a live dashboard over the transcripts on your disk.",
  "keywords": [
    "agents",
    "bun",
    "claude-code",
    "dashboard",
    "observability",
    "sqlite",
    "subagents",
    "transcripts"
  ],
  "homepage": "https://github.com/viktoravelino/tracetree#readme",
  "bugs": {
    "url": "https://github.com/viktoravelino/tracetree/issues"
  },
  "license": "MIT",
  "author": "Viktor Avelino",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viktoravelino/tracetree.git"
  },
  "bin": {
    "tracetree": "src/cli.ts"
  },
  "files": [
    "LICENSE",
    "README.md",
    "scripts/demo.ts",
    "src",
    "tsconfig.json",
    "web",
    "web/app.css"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "bun run build:css && bun --hot src/cli.ts serve",
    "serve": "bun run build:css && bun run src/cli.ts serve",
    "demo": "bun run build:css && bun run scripts/demo.ts",
    "ingest": "bun run src/cli.ts ingest",
    "stats": "bun run src/cli.ts stats",
    "tree": "bun run src/cli.ts tree",
    "query": "bun run src/cli.ts query",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "release": "scripts/release.sh",
    "build:css": "tailwindcss -i web/styles.css -o web/app.css --minify",
    "prepack": "bun run build:css"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.39.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/bun": "latest",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "bun-plugin-tailwind": "^0.1.2",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.1"
  }
}
